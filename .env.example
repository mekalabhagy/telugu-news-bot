# Copy to .env and fill in. Never commit .env.

# --- Branding ---
CHANNEL_NAME=తెలుగు తాజా వార్తలు
CHANNEL_HANDLE=@your_handle

# --- Behaviour ---
# review = cards wait for your approval, auto = fully autonomous
POST_MODE=review
POSTS_PER_RUN=2
MIN_SOURCES=2
SKIP_SENSITIVE=true

# --- LLM: use ONE of these (Gemini has a free tier) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# --- Instagram Graph API ---
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- Public image hosting (S3-compatible, e.g. Cloudflare R2) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
